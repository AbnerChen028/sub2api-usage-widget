<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abnerchen.sub2api-usage-widget</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>"__APP_SUPPORT_DIR__/Sub2APIUsageWidget" "__APP_SUPPORT_DIR__/sub2api-usage.widget/scripts/fetch-usage.mjs"</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__APP_SUPPORT_DIR__/logs/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>__APP_SUPPORT_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
